# Application
NODE_ENV=development
LOG_LEVEL=debug
PORT=5000

# Database and queue
MONGO_URI=mongodb://localhost:27017/jobportal?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-long-random-secret-min-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@jobportal.local
OTP_EXPIRES_IN_MINUTES=15
INVITATION_EXPIRES_IN_HOURS=72

# APP_BASE_URL is used to create frontend links in verification and invitation emails.
# FRONTEND_URL is the frontend origin allowed by the API's CORS policy.
# They normally have the same value, but serve different purposes.
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Cache and rate limiting
CACHE_TTL_SECONDS=60
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Cloudinary document storage
CLOUD_NAME=your-cloud-name
CLOUD_API_KEY=your-api-key
CLOUD_SECRET_KEY=your-api-secret
